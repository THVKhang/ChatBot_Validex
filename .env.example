# ============================================================
# ChatBot Validex — Environment Variable Reference
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.
# ============================================================

# ── LLM Provider ────────────────────────────────────────────
# Options: auto | google | openai
# "auto" detects available API keys in order: Google → OpenAI → Groq
LLM_PROVIDER=google

# Google Gemini (recommended — free tier available at aistudio.google.com)
GOOGLE_API_KEY=your_google_api_key_here
LLM_MODEL_PRO=models/gemini-2.5-flash
LLM_MODEL_FAST=models/gemini-2.0-flash-lite
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001

# OpenAI (optional alternative)
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=google

# Enable live LLM calls (REQUIRED for production, set 0 for test mode)
USE_LIVE_LLM=1

# ── Authentication ──────────────────────────────────────────
# REQUIRED: Random secret string for JWT token signing (at least 32 chars)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET

# ── Database — PostgreSQL + pgvector ────────────────────────
# REQUIRED: PostgreSQL connection string with pgvector extension
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# pgvector configuration
USE_PGVECTOR_RETRIEVAL=1
PGVECTOR_TABLE=validex_knowledge
PGVECTOR_MIN_SIMILARITY=0.15
PGVECTOR_REQUIRE_NON_FAKE_EMBEDDINGS=1

# ── Vector Store — Pinecone (optional) ───────────────────────
USE_PINECONE_RETRIEVAL=0
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_NAMESPACE=default

# ── Redis (optional but recommended) ────────────────────────
REDIS_URL=redis://localhost:6379/0
USE_REDIS_SESSIONS=0
USE_REDIS_RATE_LIMIT=0

# ── Generation ───────────────────────────────────────────────
USE_STRUCTURED_OUTPUT=1
USE_AGENTIC_RAG=1

# Writer temperature: higher = more creative prose
WRITER_TEMPERATURE=0.7
# Editor temperature: lower = more consistent evaluation
EDITOR_TEMPERATURE=0.1
# Optional: use a different model for Editor (breaks Debate Agent Problem)
EDITOR_MODEL_NAME=
EDITOR_GOOGLE_MODEL_NAME=

# ── Embeddings ───────────────────────────────────────────────
# Set ALLOW_FAKE_EMBEDDINGS=1 only for local testing without a real embedding API
ALLOW_FAKE_EMBEDDINGS=0
FAKE_EMBEDDING_DIM=1536
GOOGLE_EMBEDDING_OUTPUT_DIMENSION=1536

# ── Retrieval Tuning ────────────────────────────────────────
TOP_K=3
TOP_K_SHORT_MIN=3
TOP_K_SHORT_MAX=4
TOP_K_MEDIUM_MIN=6
TOP_K_MEDIUM_MAX=8
TOP_K_LONG_MIN=10
TOP_K_LONG_MAX=12
CHUNK_TOKEN_ESTIMATE=260
MIN_TOP_SCORE=3
MIN_CONFIDENCE=0.35

# ── Token Budgeting ─────────────────────────────────────────
OUTPUT_TOKENS_SHORT=600
OUTPUT_TOKENS_MEDIUM=1200
OUTPUT_TOKENS_LONG=1800
INPUT_OUTPUT_RATIO_MIN=1.5
INPUT_OUTPUT_RATIO_MAX=2.0

# ── Per-User Token Quotas (daily limits) ────────────────────
QUOTA_FREE=25000
QUOTA_STARTER=80000
QUOTA_PRO=250000
QUOTA_ENTERPRISE=1000000

# ── Hybrid Fallback ─────────────────────────────────────────
# 1 = use general LLM knowledge when RAG retrieval is insufficient
# 0 = strict "Need More Context" mode (no hallucination risk)
ALLOW_HYBRID_FALLBACK=1
HYBRID_WARNING_TEXT=Note: Parts of this article were generated using external knowledge and may not be grounded in the internal knowledge base.

# ── Images — Unsplash ───────────────────────────────────────
USE_UNSPLASH_IMAGES=1
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
UNSPLASH_API_BASE=https://api.unsplash.com
UNSPLASH_TIMEOUT_SECONDS=8

# ── Quality Gate ─────────────────────────────────────────────
ENFORCE_QUALITY_GATE=1
MIN_SECTIONS=3
MIN_SOURCES_USED=1
MIN_DRAFT_CHARS=700
AGENT_MAX_ITERATIONS=4

# ── Rate Limiting ────────────────────────────────────────────
USE_RATE_LIMIT=1
RATE_LIMIT_PER_MINUTE=30
BURST_LIMIT_PER_10S=5
MAX_CONCURRENT_PER_IP=3
MAX_CONCURRENT_LLM_REQUESTS=10
REQUEST_TIMEOUT_SECONDS=180
MAX_RESPONSE_SIZE_BYTES=102400

# ── CORS & Sessions ─────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8000,http://localhost:8001
# Session idle timeout in seconds (default: 1 hour)
SESSION_TTL_SECONDS=3600
SESSION_EVICTION_INTERVAL=300
MAX_CONVERSATION_TURNS=5

# ── Connection Pool ──────────────────────────────────────────
DB_POOL_MIN=2
DB_POOL_MAX=20

# ── Security ─────────────────────────────────────────────────
ENABLE_SECURITY_HEADERS=1
ENABLE_PROMPT_GUARD=1
MAX_PROMPT_LENGTH=10000

# ── Response Cache ───────────────────────────────────────────
CACHE_ENABLED=1
CACHE_MAX_ENTRIES=100
CACHE_TTL_SECONDS=900

# ── Admin ────────────────────────────────────────────────────
ADMIN_API_KEY=

# ── AI Discovery Agent ──────────────────────────────────────
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
DISCOVERY_MAX_NEW_URLS=20
DISCOVERY_MIN_RELEVANCE_SCORE=7

# ── Data Paths ───────────────────────────────────────────────
DATA_PROCESSED_DIR=data/processed
METADATA_PATH=data/metadata/documents.json
REPORTS_PATH=data/reports/reports.json
VALIDEX_WEBSITE_URL=https://www.validex.com.au
TOOL_ALLOWED_DOMAINS=validex.com.au,www.validex.com.au,acic.gov.au,www.acic.gov.au,afp.gov.au,www.afp.gov.au,oaic.gov.au,www.oaic.gov.au

# ── LLMOps (LangSmith — optional but recommended) ──────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=validex_pipeline

# ── ML/DL Quality Control Pipeline ──────────────────────────
# Operating mode for ML Quality Gate:
#   shadow  = log predictions for human review, never block (Phase 1, default)
#   enforce = auto-reject low quality when model confidence > 80% (Phase 2)
# Auto-promotes from shadow → enforce when model F1-score > 0.85
ML_GATE_MODE=shadow

# ── AI Content Evaluator ────────────────────────────────────
AI_EVALUATOR_ENABLED=0
AI_EVALUATOR_MIN_SCORE=6

# ── Debugging ────────────────────────────────────────────────
LOG_RAW_LLM_IO=0
METRICS_WINDOW_SIZE=200

# ── Circuit Breaker ──────────────────────────────────────────
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
